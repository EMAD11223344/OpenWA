{
  "name": "@openwa/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Business-OS central WhatsApp engine (QR_EXPERIMENTAL provider). Raw Baileys, outbound control WSS into the Brain. See docs/whatsapp-central-engine-migration-plan.md",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "mock": "tsx src/internal/mock-brain.ts",
    "test:protocol": "tsx tests/protocol-smoke.ts",
    "test:snapshot": "tsx tests/snapshot-roundtrip.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@whiskeysockets/baileys": "6.7.24",
    "https-proxy-agent": "^9.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  }
}
